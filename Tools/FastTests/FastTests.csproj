<Project Sdk="Microsoft.NET.Sdk">
  <!-- 자동화 C: Unity 밖 빠른 테스트. Core · Data · GameKit.Core(엔진 없음)와 EditMode 테스트를 그대로 묶어 dotnet test로 돌린다.
       Unity가 있어야 하는 테스트(폰트 · UI 숫자 표기)만 뺀다. 원본 파일은 Assets에 그대로 있고 여기서는 링크만 한다 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;NUnit2005;NUnit2007</NoWarn>
    <UnityProject>$(MSBuildThisFileDirectory)..\..\ProjectTycoon</UnityProject>
    <GameKit>$(MSBuildThisFileDirectory)..\..\..\UnityGameKit</GameKit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityProject)\Assets\Scripts\Core\**\*.cs" />
    <Compile Include="$(UnityProject)\Assets\Scripts\Data\**\*.cs" />
    <Compile Include="$(GameKit)\Runtime\Core\**\*.cs" />
    <Compile Include="$(UnityProject)\Assets\Tests\EditMode\**\*.cs"
             Exclude="$(UnityProject)\Assets\Tests\EditMode\FontAssetTests.cs;$(UnityProject)\Assets\Tests\EditMode\BigNumberFormatterTests.cs" />
    <Compile Include="UnityProjectRoot.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UnityProject</_Parameter1>
      <_Parameter2>$(UnityProject)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
